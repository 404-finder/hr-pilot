# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=USER_ID_1,USER_ID_2  # Whitelist authorized users

# ADP Credentials - one set per Telegram user
# Add more sets by incrementing the number (1, 2, 3, ...)
ADP_USERNAME_1=username1
ADP_PASSWORD_1=password1
TELEGRAM_USER_ID_1=USER_ID_1

ADP_USERNAME_2=username2
ADP_PASSWORD_2=password2
TELEGRAM_USER_ID_2=USER_ID_2

# App Settings
LOG_LEVEL=INFO
HEADLESS=true  # Run browser in headless mode
SCREENSHOT_DIR=screenshots
